{
  "multipart": [
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot"
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot_port"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot",
        "y": 90
      },
      "when": {
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot_port",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot",
        "y": 180
      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot_port",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot",
        "y": 270
      },
      "when": {
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot_port",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "dust:block/apparatus/still_pot_port_up"
      },
      "when": {
        "up": "true"
      }
    }
  ]
}